{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components.jsx",
              "preview/**",
              "screens.jsx",
              "ui_kits/bista-hr/**",
              "ui_kits/bista-hr/src/**",
              "ui_kits/bista-hr/src/admin/**",
              "ui_kits/bista-hr/src/appraisal/**",
              "ui_kits/bista-hr/src/approvals/**",
              "ui_kits/bista-hr/src/crud/**",
              "ui_kits/bista-hr/src/dashboard/**",
              "ui_kits/bista-hr/src/data/**",
              "ui_kits/bista-hr/src/employee/**",
              "ui_kits/bista-hr/src/engagement/**",
              "ui_kits/bista-hr/src/engagement/accommodation/**",
              "ui_kits/bista-hr/src/engagement/apartments/**",
              "ui_kits/bista-hr/src/engagement/disciplinary/**",
              "ui_kits/bista-hr/src/engagement/welfare/**",
              "ui_kits/bista-hr/src/exit/**",
              "ui_kits/bista-hr/src/forms/**",
              "ui_kits/bista-hr/src/jobtitle/**",
              "ui_kits/bista-hr/src/leave-admin/**",
              "ui_kits/bista-hr/src/leave/**",
              "ui_kits/bista-hr/src/overlays/**",
              "ui_kits/bista-hr/src/primitives/**",
              "ui_kits/bista-hr/src/promotions/**",
              "ui_kits/bista-hr/src/screens/**",
              "ui_kits/bista-hr/src/shell/**",
              "ui_kits/bista-hr/src/target/**",
              "ui_kits/bista-hr/src/transfers/**",
              "ui_kits/bista-hr/src/workflow/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Mona Sans))/i]",
        "message": "Font not provided by the design system. Available: Mona Sans."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
